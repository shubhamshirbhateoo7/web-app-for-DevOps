# Copy to .env and fill in values
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — points to your RDS endpoint after deploy
DB_NAME=appdb
DB_USER=appadmin
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# S3 — your static-assets bucket name
S3_BUCKET_NAME=your-project-name-static-assets-123456789012
AWS_REGION=us-east-1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
